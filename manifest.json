{
  "manifest_version": 3,
  "name": "Scholar Stack",
  "version": "1.0.0",
  "description": "a browser extension helping people organize the way they read research papers",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "images/scholarstack.png",
    "48": "images/scholarstack.png",
    "128": "images/scholarstack.png"
  }
}